NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=PB Pay
APP_URL=http://localhost:5000
MONGODB_URI=mongodb://localhost:27017/pbpay
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PB Pay <no-reply@example.com>
GEMINI_API_KEY=
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=
PAWAPAY_WEBHOOK_SECRET=
PLATFORM_NATIONAL_FEE_PERCENT=0.8
PLATFORM_INTERNATIONAL_FEE_PERCENT=1.2
LOG_LEVEL=info
